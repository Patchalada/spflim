# Database and JWT settings. Keep production credentials in backend/.env only.
PORT=5000
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-database-user
DB_PASSWORD=
DB_NAME=your-database-name
JWT_SECRET=

# For production, set this to the public frontend origin, e.g. http://203.0.113.10
ALLOWED_ORIGINS=http://localhost:5173

# Use "api" only after enabling the SlipOK API package and configuring the branch account.
SLIPOK_MODE=manual

# Local/demo only. Supported results: approved, rejected, duplicate, review.
# approved marks the bill paid with an explicit DEMO marker; never use in production.
# SLIPOK_MODE=mock
# SLIPOK_MOCK_RESULT=review

# Real SlipOK API settings. Keep credentials in backend/.env only.
# Uncomment SLIPOK_MODE=api after adding credentials.
# SLIPOK_MODE=api
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# LINE Messaging API credentials (optional; leave unset to log notifications locally).
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_ADMIN_RECIPIENT_ID=
