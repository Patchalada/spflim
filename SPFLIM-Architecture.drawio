  <diagram id="spflim-erd" name="Database ERD">
    <mxGraphModel dx="1737" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-erd" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#123B3A;" value="SPFLIM — Database Relationships (PostgreSQL)" vertex="1">
          <mxGeometry height="40" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFB;strokeColor=#0F766E;fontSize=13;align=left;spacingLeft=12;spacing=8;" value="m_users&#xa;PK user_id&#xa;UQ username&#xa;role, status&#xa;profile / KYC fields" vertex="1">
          <mxGeometry height="135" width="210" x="50" y="150" as="geometry" />
        </mxCell>
        <mxCell id="rooms" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFB;strokeColor=#0F766E;fontSize=13;align=left;spacingLeft=12;spacing=8;" value="m_rooms&#xa;PK room_id&#xa;UQ room_number&#xa;floor, room_type&#xa;base_price, status" vertex="1">
          <mxGeometry height="135" width="210" x="50" y="390" as="geometry" />
        </mxCell>
        <mxCell id="contracts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=12;spacing=8;" value="m_contracts&#xa;PK contract_id&#xa;FK room_id → m_rooms&#xa;FK tenant_id → m_users&#xa;dates, deposit, status&#xa;signatures / documents" vertex="1">
          <mxGeometry height="170" width="245" x="380" y="270" as="geometry" />
        </mxCell>
        <mxCell id="bills" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=12;spacing=8;" value="t_bills&#xa;PK bill_id&#xa;FK contract_id → m_contracts&#xa;period, rent, utilities&#xa;total_amount, payment_status&#xa;slip verification fields" vertex="1">
          <mxGeometry height="165" width="255" x="735" y="245" as="geometry" />
        </mxCell>
        <mxCell id="transactions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=13;align=left;spacingLeft=12;spacing=8;" value="t_transactions&#xa;PK transaction_id&#xa;FK bill_id → t_bills (optional)&#xa;type, amount, category&#xa;payment reference / notes" vertex="1">
          <mxGeometry height="145" width="245" x="1100" y="255" as="geometry" />
        </mxCell>
        <mxCell id="renewals" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontSize=12;align=left;spacingLeft=12;spacing=8;" value="m_contract_renewal_requests&#xa;PK request_id&#xa;FK contract_id → m_contracts&#xa;FK tenant_id → m_users&#xa;FK reviewed_by → m_users&#xa;status, dates, documents" vertex="1">
          <mxGeometry height="165" width="270" x="380" y="520" as="geometry" />
        </mxCell>
        <mxCell id="tickets" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontSize=12;align=left;spacingLeft=12;spacing=8;" value="t_maintenance_tickets&#xa;PK ticket_id&#xa;FK tenant_id → m_users&#xa;FK contract_id → m_contracts (optional)&#xa;priority, status, response" vertex="1">
          <mxGeometry height="150" width="275" x="50" y="650" as="geometry" />
        </mxCell>
        <mxCell id="notifications" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=12;align=left;spacingLeft=12;spacing=8;" value="t_notifications&#xa;PK notification_id&#xa;FK user_id → m_users (optional)&#xa;target_role, title, message&#xa;type, link, is_read" vertex="1">
          <mxGeometry height="140" width="250" x="50" y="870" as="geometry" />
        </mxCell>
        <mxCell id="kyc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontSize=11;align=left;spacingLeft=12;spacing=6;" value="m_kyc_reviews&#xa;PK review_id&#xa;FK user_id → m_users&#xa;FK reviewed_by → m_users&#xa;FK requested_room_id → m_rooms (optional)&#xa;FK assigned_room_id → m_rooms (optional)&#xa;FK contract_id → m_contracts (optional)" vertex="1">
          <mxGeometry height="185" width="300" x="380" y="770" as="geometry" />
        </mxCell>
        <mxCell id="billing-settings" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=12;align=left;spacingLeft=12;spacing=8;" value="m_billing_settings&#xa;PK setting_id (singleton)&#xa;dormitory details&#xa;water_rate, electric_rate&#xa;payment instructions" vertex="1">
          <mxGeometry height="130" width="245" x="735" y="500" as="geometry" />
        </mxCell>
        <mxCell id="room-types" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=12;align=left;spacingLeft=12;spacing=8;" value="m_room_types&#xa;PK type_id&#xa;UQ room_type&#xa;base_price" vertex="1">
